# Ambiente
NODE_ENV=development
PORT=3000

# Banco de Dados (PostgreSQL)
DATABASE_URL=postgresql://user:password@db:5432/rato_db?schema=public

# MQTT Broker (Mosquitto)
MQTT_URL=mqtt://broker:1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=telemetry-backend
MQTT_TOPIC_TELEMETRY=rato/telemetria

# WebSockets e API
CORS_ORIGIN=http://localhost:5173
WS_CORS_ORIGIN=http://localhost:5173

# Telemetria
TELEMETRY_HISTORY_LIMIT=100
TELEMETRY_MOCK_ENABLED=true
