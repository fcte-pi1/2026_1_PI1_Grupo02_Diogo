generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Telemetria bruta recebida via MQTT (Histórico/Auditoria de segurança)
model TelemetryRaw {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  topic     String
  robotId   String?
  payload   Json

  @@index([createdAt])
  @@index([robotId])
}

// Labirintos (Estrutura geométrica estática de um mapa)
model Maze {
  id        String   @id @default(uuid())
  name      String
  width     Int      @default(16) // Suporta adaptações de chaves físicas: 4, 8 ou 16
  height    Int      @default(16)
  createdAt DateTime @default(now())

  cells    Cell[]
  sessions Session[]
}

// Células estáticas do labirinto (Definição física das paredes)
model Cell {
  id     String @id @default(uuid())
  mazeId String
  maze   Maze   @relation(fields: [mazeId], references: [id], onDelete: Cascade)

  posX Int
  posY Int

  wallNorth Boolean @default(false)
  wallSouth Boolean @default(false)
  wallEast  Boolean @default(false)
  wallWest  Boolean @default(false)

  @@unique([mazeId, posX, posY])
  @@index([mazeId])
}

// Sessões / Corridas (Histórico geral do cockpit)
model Session {
  id          String   @id @default(uuid())
  sessionName String
  algorithm   String   // "DFS" para exploração ou "Flood Fill" para corrida rápida
  mode        String   // "Exploração" ou "Corrida" (Dip switch configurado)
  createdAt   DateTime @default(now())

  durationMs   Int?
  avgSpeed     Float?
  isCompleted  Boolean @default(false)

  // Registro do ponto inicial sorteado para a corrida
  startPosX    Int?
  startPosY    Int?

  // Métricas consolidadas da bateria ao fim da sessão
  initialVoltage Float?
  finalVoltage   Float?
  totalDrainMah  Float?

  // Solução para o caminho mais rápido encontrado (Array JSON de coordenadas: [{"x": 0, "y": 0}])
  fastestPath  Json?

  mazeId String
  maze   Maze   @relation(fields: [mazeId], references: [id])

  telemetrySteps SessionStep[]
  logs           TelemetryLog[]

  @@index([mazeId])
  @@index([createdAt])
}

// Rastreamento temporal passo a passo (O Trajeto Feito + Telemetria Elétrica Síncrona)
model SessionStep {
  id        String   @id @default(uuid())
  sessionId String
  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  
  timestamp DateTime @default(now())
  stepOrder Int      // Garante a ordenação sequencial exata do trajeto percorrido

  // Posição em tempo real do robô (Coordenadas do trajeto feito)
  posX Int
  posY Int

  // Dados coletados pelo sensor INA219 para alimentar os gráficos do frontend
  voltage      Float    // Tensão instantânea em Volts (ex: 11.1)
  current      Float    // Corrente instantânea em Miliampères (ex: 250.5)
  consumption  Float?   // Consumo acumulado calculados no backend/firmware

  @@index([sessionId])
  @@index([stepOrder])
}

// Logs de auditoria do sistema de telemetria
model TelemetryLog {
  id        String   @id @default(uuid())
  sessionId String
  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  timestamp DateTime @default(now())
  logType   String
  message   String   @db.Text

  @@index([sessionId])
  @@index([timestamp])
}