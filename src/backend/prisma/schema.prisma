generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Telemetria em tempo real (payload MQTT bruto)
model Telemetry {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  topic     String
  robotId   String?
  payload   Json

  @@index([createdAt])
  @@index([robotId])
}

// Labirintos (estrutura geométrica de testes)
model Maze {
  id        String    @id @default(uuid())
  name      String
  createdAt DateTime  @default(now())

  cells    Cell[]
  sessions Session[]
}

// Sessões / corridas (histórico geral do cockpit)
model Session {
  id          String   @id @default(uuid())
  sessionName String
  algorithm   String
  mode        String
  createdAt   DateTime @default(now())

  durationMs   Int?
  avgSpeed     Float?
  batteryDrain Float?
  isCompleted  Boolean @default(false)

  mazeId String
  maze   Maze   @relation(fields: [mazeId], references: [id])

  logs TelemetryLog[]

  @@index([mazeId])
  @@index([createdAt])
}

// Células (mapeamento da matriz 16x16)
model Cell {
  id     String @id @default(uuid())
  mazeId String
  maze   Maze   @relation(fields: [mazeId], references: [id], onDelete: Cascade)

  posX Int
  posY Int

  wallNorth Boolean @default(false)
  wallSouth Boolean @default(false)
  wallEast  Boolean @default(false)
  wallWest  Boolean @default(false)
  isVisited Boolean @default(false)

  @@unique([mazeId, posX, posY])
  @@index([mazeId])
}

// Logs de auditoria (aba de logs do sistema)
model TelemetryLog {
  id        String   @id @default(uuid())
  sessionId String
  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  timestamp DateTime @default(now())
  logType   String
  message   String   @db.Text

  @@index([sessionId])
  @@index([timestamp])
}
